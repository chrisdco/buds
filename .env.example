# Copy to .env and fill in from your Supabase project:
# Dashboard -> Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Routing (both optional — the chain degrades gracefully without them):
# - Free OpenRouteService key (openrouteservice.org -> Dashboard -> Tokens);
#   without it the chain skips straight to OSRM. See issue #9.
# EXPO_PUBLIC_ORS_API_KEY=
# - Self-hosted OSRM base URL (same /route/v1/driving API); without it the
#   public demo server is used (~1 req/s courtesy limit, no SLA). See #9.
# EXPO_PUBLIC_OSRM_URL=
