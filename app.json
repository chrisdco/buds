{
  "expo": {
    "name": "Buds",
    "slug": "buds",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "buds",
    // Dark-only product (law 2: ink canvas, Uber duet): pin the scheme so
    // native surfaces default to dark instead of following the device.
    // Needs a rebuild to take effect.
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.buds.app",
      "infoPlist": {
        "UIBackgroundModes": ["location"],
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "package": "com.buds.app",
      "permissions": ["android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"],
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 120
          }
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationWhenInUsePermission": "Buds shares your live location with members of your room during a trip.",
          "locationAlwaysAndWhenInUsePermission": "Buds shares your live location with members of your room while a trip is active, including while the app is in the background.",
          "locationAlwaysPermission": "Buds shares your live location with members of your room even when the app is in the background, so your group can keep track of you during a trip."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Buds uses the camera to scan room invite QR codes."
        }
      ],
      "expo-notifications",
      // In-app icon choice (Profile -> App icon). Default stays the
      // top-level icon (Geist Serif "buds"); these are the alternates.
      // Rendered by scripts/render-icons.mjs from assets/icons/src/.
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "GeistB",
            "ios": "./assets/icons/alt/GeistB-ios.png",
            "android": {
              "foregroundImage": "./assets/icons/alt/GeistB-android.png",
              "backgroundColor": "#000000"
            }
          },
          {
            "name": "FrauncesB",
            "ios": "./assets/icons/alt/FrauncesB-ios.png",
            "android": {
              "foregroundImage": "./assets/icons/alt/FrauncesB-android.png",
              "backgroundColor": "#000000"
            }
          }
        ]
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "82a2e5a4-b425-44a1-bcc3-ccd820840087"
      }
    },
    "owner": "chrisdcosta",
    // OTA updates (EAS Update). Builds only accept updates with the same
    // runtime, here the app "version". Bump "version" with every native
    // change (new native module, icon, plugin) so OTA can't land JS on an
    // APK that lacks it. (Not "fingerprint": Windows CRLF checkouts hash
    // differently from EAS's Linux checkout and the build fails.)
    "runtimeVersion": { "policy": "appVersion" },
    "updates": {
      "url": "https://u.expo.dev/82a2e5a4-b425-44a1-bcc3-ccd820840087"
    }
  }
}
