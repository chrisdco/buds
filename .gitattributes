# Normalize line endings: store LF in the repo, check out native on Windows.
# Stops the "LF will be replaced by CRLF" warning spam on this Windows machine.
* text=auto eol=lf

# Binary assets — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.keystore binary
*.jks binary
